{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug (Desktop)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "FLEXRAW_BUILD_DESKTOP": "ON",
        "FLEXRAW_BUILD_WORKER": "OFF",
        "FLEXRAW_BUILD_TESTS": "ON",
        "FLEXRAW_BUILD_UI_TESTS": "ON",
        "FLEXRAW_BUILD_BENCHMARKS": "OFF",
        "FLEXRAW_WINDOWS_DEBUG_CONSOLE": "ON"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release (Desktop)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "FLEXRAW_BUILD_DESKTOP": "ON",
        "FLEXRAW_BUILD_WORKER": "OFF",
        "FLEXRAW_BUILD_TESTS": "ON",
        "FLEXRAW_BUILD_UI_TESTS": "ON",
        "FLEXRAW_BUILD_BENCHMARKS": "OFF",
        "FLEXRAW_WINDOWS_DEBUG_CONSOLE": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "QT_PLUGIN_PATH": "${sourceDir}/build/debug/vcpkg_installed/x64-windows/debug/Qt6/plugins",
        "QT_QPA_PLATFORM": "minimal"
      }
    },
    {
      "name": "release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "QT_PLUGIN_PATH": "${sourceDir}/build/release/vcpkg_installed/x64-windows/Qt6/plugins",
        "QT_QPA_PLATFORM": "minimal"
      }
    }
  ]
}
