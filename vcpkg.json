{
  "name": "flexraw",
  "version": "0.2.0",
  "default-features": [
    "desktop",
    "tests"
  ],
  "features": {
    "desktop": {
      "description": "Desktop UI and Catalog dependencies",
      "dependencies": [
        "exiv2",
        "lcms",
        {
          "name": "libiconv",
          "platform": "windows"
        },
        "libraw",
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "gui",
            "jpeg",
            "network",
            "png",
            "sql",
            "thread",
            "widgets"
          ]
        },
        "qtimageformats",
        "spdlog"
      ]
    },
    "mcp": {
      "description": "Standalone MCP Product Runtime dependencies without Desktop UI",
      "dependencies": [
        "exiv2",
        "lcms",
        {
          "name": "libiconv",
          "platform": "windows"
        },
        "libraw",
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "gui",
            "sql",
            "thread"
          ]
        },
        "spdlog"
      ]
    },
    "tests": {
      "description": "Google Test dependency",
      "dependencies": [
        "gtest"
      ]
    },
    "worker": {
      "description": "Bounded render worker dependencies",
      "dependencies": [
        "exiv2",
        "lcms",
        {
          "name": "libiconv",
          "platform": "windows"
        },
        "libraw",
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "gui",
            "jpeg",
            "network",
            "png",
            "thread"
          ]
        },
        "spdlog"
      ]
    }
  }
}
