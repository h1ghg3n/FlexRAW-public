# 기본: 텍스트로 자동 인식, EOL 정규화 (working tree 는 OS 기본)
* text=auto

# 명시적 텍스트
*.cpp       text diff=cpp
*.cxx       text diff=cpp
*.cc        text diff=cpp
*.h         text diff=cpp
*.hpp       text diff=cpp
*.hxx       text diff=cpp
*.inl       text diff=cpp

CMakeLists.txt  text
*.cmake         text
*.json          text
*.yml           text
*.yaml          text
*.toml          text
*.md            text
*.txt           text
*.qrc           text
*.ui            text
*.ts            text

# Windows 전용은 CRLF 강제
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.psd1      text eol=crlf

# Unix 쉘 스크립트는 LF 강제
*.sh        text eol=lf

# 바이너리 (diff 비활성)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.bmp       binary
*.tiff      binary
*.tif       binary
*.ico       binary
*.icns      binary
*.pdf       binary
*.zip       binary
*.7z        binary
*.gz        binary
*.tar       binary
*.qm        binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary

# RAW 샘플 / ML 모델 — repo에는 pointer 없이 binary로만 인식
*.arw       binary
*.arq       binary
*.cr2       binary
*.cr3       binary
*.nef       binary
*.nrw       binary
*.dng       binary
*.raf       binary
*.rw2       binary
*.orf       binary
*.pef       binary

*.onnx      binary
*.gguf      binary
*.safetensors binary

# GitHub Linguist — generated 폴더는 통계에서 제외
build/**            linguist-generated=true
vcpkg_installed/**  linguist-vendored=true
documents/**        linguist-documentation=true
