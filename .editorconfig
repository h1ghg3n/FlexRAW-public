root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,cxx,cc,h,hpp,hxx,inl}]
indent_size = 4

[CMakeLists.txt]
indent_size = 4

[*.cmake]
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{ts,qrc,ui}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[*.{ps1,psm1,psd1}]
end_of_line = crlf

[Makefile]
indent_style = tab
